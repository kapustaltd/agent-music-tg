[Unit]
Description=Agent Music Telegram Bot + Mini App API (reserve production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meatproxy
Group=meatproxy
WorkingDirectory=/opt/meatproxy-prod/current
EnvironmentFile=/etc/meatproxy/prod.env
ExecStart=/usr/local/bin/bun run server/index.ts
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
